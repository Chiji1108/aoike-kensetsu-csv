{
  "name": "aoike-kensetsu-csv",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.2",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev --port 3211",
    "build": "vite build",
    "preview": "bun run build && vite preview",
    "deploy": "bun run build && wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "cf-typegen": "wrangler types",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "set-password": "bun scripts/set-password.ts",
    "make-fixtures": "bun scripts/make-sample-messy.ts && bun scripts/make-sample-no-address.ts && bun scripts/make-sample-large.ts && bun scripts/make-gyoshu-check-csv.ts",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "4.0.91",
    "@ai-sdk/react": "4.0.160",
    "@anthropic-ai/sdk": "^0.135.0",
    "@base-ui/react": "^1.9.0",
    "@geolonia/normalize-japanese-addresses": "3.1.3",
    "@shadcn/react": "^0.3.1",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/react-router": "1.170.44",
    "@tanstack/react-start": "1.169.1",
    "@tanstack/react-table": "^9.3.1",
    "@tanstack/react-virtual": "^3.14.23",
    "ai": "7.0.156",
    "better-auth": "^1.7.7",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "diff": "9.0.0",
    "drizzle-orm": "^0.45.4",
    "encoding-japanese": "^2.4.0",
    "exceljs": "^4.4.0",
    "lucide-react": "^1.57.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sonner": "^2.0.8",
    "streamdown": "2.7.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.1.18",
    "tw-animate-css": "^1.4.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.26.0",
    "@playwright/test": "^1.64.1",
    "@types/bun": "^1.4.3",
    "@types/encoding-japanese": "^2.4.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.1",
    "drizzle-kit": "^0.31.11",
    "shadcn": "^4.21.5",
    "typescript": "^6.0.2",
    "vite": "^8.0.0",
    "wrangler": "^4.151.0"
  }
}
